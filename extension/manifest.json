{
  "manifest_version": 3,
  "name": "Qwen Agentic Web Assistant",
  "version": "0.1.0",
  "description": "Summarize webpages with your local Qwen assistant.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {"default_popup": "popup/popup.html"},
  "content_scripts": [{"matches":["http://*/*","https://*/*"],"js":["content/content.js"],"run_at":"document_idle"}]
}
